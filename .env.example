DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,api
DATABASE_URL=postgresql://pkuba:pkuba@127.0.0.1:5432/pkuba
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_API_BASE_URL=https://api.weixin.qq.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
QWEN_REASONING_EFFORT=xhigh
SCORESHEET_RECOGNITION_UPSCALE_TARGET_PIXELS=8000000
SCORESHEET_RECOGNITION_TIMEOUT_SECONDS=180
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=15
EMAIL_FROM=PKUBA <no-reply@localhost>
LOCAL_MEDIA_ROOT=.local/media
LOCAL_ARCHIVE_ROOT=.local/archives
PG_DUMP_BINARY=pg_dump
PG_RESTORE_BINARY=pg_restore
PKUBA_GIT_COMMIT=development
