DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,api
DATABASE_URL=postgresql://pkuba:pkuba@127.0.0.1:5432/pkuba
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_API_BASE_URL=https://api.weixin.qq.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max-latest
QWEN_TIMEOUT_SECONDS=120
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_FROM=PKUBA <no-reply@localhost>
STAFF_NOTIFICATION_EMAILS=
# Reserved for a future verified COS storage backend. The current deployment
# uses Django's private local media storage; setting COS_* alone has no effect.
STORAGE_BACKEND=local
LOCAL_MEDIA_ROOT=.local/media
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
