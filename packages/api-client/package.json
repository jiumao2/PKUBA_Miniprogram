{
  "name": "@pkuba/api-client",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@pkuba/scoresheet-domain": "1.0.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../docs/openapi.json -o src/generated/schema.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.2"
  }
}
