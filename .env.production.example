# Docker images published from a version tag such as v0.1.0.
PKUBA_API_IMAGE=ghcr.io/jiumao2/pkuba-api:v0.1.0
PKUBA_WEB_IMAGE=ghcr.io/jiumao2/pkuba-web:v0.1.0

# Caddy obtains HTTPS certificates after both DNS records point to the server.
PKUBA_DOMAIN=pkuba.cn
ACME_EMAIL=806628409@qq.com

# PostgreSQL. Keep POSTGRES_PASSWORD and the password inside DATABASE_URL identical.
# Generate an URL-safe random password rather than reusing a personal password.
POSTGRES_DB=pkuba
POSTGRES_USER=pkuba
POSTGRES_PASSWORD=replace-with-a-url-safe-random-value
DATABASE_URL=postgresql://pkuba:replace-with-a-url-safe-random-value@db:5432/pkuba

# Django production security.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.pkuba.cn,admin.pkuba.cn,api
DJANGO_SECURE_COOKIES=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
CSRF_TRUSTED_ORIGINS=https://admin.pkuba.cn

# WeChat Mini Program. Enter the AppSecret only on the server.
WECHAT_APP_ID=wxc9104b1a61511ee3
WECHAT_APP_SECRET=replace-on-server
WECHAT_API_BASE_URL=https://api.weixin.qq.com

# Email is deferred. The outbox service is disabled unless the email profile is enabled.
EMAIL_HOST=127.0.0.1
EMAIL_PORT=25
EMAIL_FROM=PKUBA <no-reply@pkuba.cn>
STAFF_NOTIFICATION_EMAILS=

# Production media is stored on the server's private Docker volume for now.
LOCAL_MEDIA_ROOT=/app/.local/media
