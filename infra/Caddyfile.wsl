:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /_maintenance/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/admin-web
		@html path / /index.html /scoresheet.html
		header @html Cache-Control "no-cache, must-revalidate"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
