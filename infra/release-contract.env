# A release may be switched by the automated blue/green path only after its
# migrations have been reviewed against the currently active application.
#
# The retained application and this release advertise the capability below;
# their migrations were reviewed as compatible with application-only rollback.
# Keep this at 1 only while that review remains valid.
PKUBA_PREVIOUS_APP_COMPATIBLE=1
PKUBA_APP_CAPABILITY=reschedule-route-v1
PKUBA_REQUIRED_PREVIOUS_APP_CAPABILITY=reschedule-route-v1
