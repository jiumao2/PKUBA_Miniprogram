# A release may be switched by the automated blue/green path only after its
# migrations have been reviewed against the currently active application.
#
# The present development baseline contains contract migrations that predate
# the blue/green discipline, so the first adoption must be an explicitly
# rehearsed baseline conversion. Keep this at 0 until that conversion is done;
# future expand-only releases can set it to 1 after the compatibility test.
PKUBA_PREVIOUS_APP_COMPATIBLE=0
PKUBA_APP_CAPABILITY=reschedule-route-v1
PKUBA_REQUIRED_PREVIOUS_APP_CAPABILITY=reschedule-route-v1
