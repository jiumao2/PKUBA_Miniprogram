:8080 {
	encode zstd gzip

	handle /_deployment/ready {
		header Cache-Control "no-store"
		header Content-Type "application/json; charset=utf-8"
		respond `{"status":"ok","release_tag":"{$PKUBA_RELEASE_TAG}","git_commit":"{$PKUBA_GIT_COMMIT}"}` 200
	}

	handle /api/* {
		reverse_proxy {$PKUBA_SLOT_API_UPSTREAM} {
			header_up X-Forwarded-Proto https
		}
	}

	handle /_maintenance/* {
		reverse_proxy {$PKUBA_SLOT_API_UPSTREAM} {
			header_up X-Forwarded-Proto https
		}
	}

	handle /static/* {
		root * /srv/django-static
		file_server
	}

	handle {
		root * /srv/admin-web
		@html path / /index.html /scoresheet.html
		header @html Cache-Control "no-cache, must-revalidate"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
