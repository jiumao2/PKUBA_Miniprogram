{
	email {$ACME_EMAIL}
}

(api_deployment_maintenance) {
	@deployment_maintenance file {
		root /srv/deployment-state
		try_files /maintenance.enabled
	}
	handle @deployment_maintenance {
		header Cache-Control "no-store"
		header Content-Type "application/json; charset=utf-8"
		header Retry-After "120"
		respond `{"code":"DEPLOYMENT_MAINTENANCE","message":"系统正在更新，请稍后重试。"}` 503
	}
}

(web_deployment_maintenance) {
	@deployment_maintenance file {
		root /srv/deployment-state
		try_files /maintenance.enabled
	}
	handle @deployment_maintenance {
		header Cache-Control "no-store"
		header Content-Type "text/plain; charset=utf-8"
		header Retry-After "120"
		respond "系统正在更新，请稍后重试。" 503
	}
}

api.{$PKUBA_DOMAIN} {
	encode zstd gzip
	handle /api/v1/health/live {
		reverse_proxy api:8000
	}
	handle /api/v1/health/ready {
		reverse_proxy api:8000
	}
	import api_deployment_maintenance
	handle {
		reverse_proxy api:8000
	}
}

admin.{$PKUBA_DOMAIN} {
	encode zstd gzip
	handle /_deployment/ready {
		header Cache-Control "no-store"
		header Content-Type "application/json; charset=utf-8"
		respond `{"status":"ok","release_tag":"{$PKUBA_RELEASE_TAG}","git_commit":"{$PKUBA_GIT_COMMIT}"}` 200
	}
	import web_deployment_maintenance
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /_maintenance/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/admin-web
		@html path / /index.html /scoresheet.html
		header @html Cache-Control "no-cache, must-revalidate"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
